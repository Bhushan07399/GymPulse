# GymPulse Shared Monorepo Environment Variables Example

# Backend API Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gympulse
JWT_SECRET=replace_with_a_secure_jwt_signing_secret_in_production
CORS_ORIGIN=http://localhost:3000

# Owner Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Owner & Member Mobile Configuration
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
