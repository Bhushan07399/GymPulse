generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gym {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(255)
  members         Member[]
  membershipPlans MembershipPlan[]

  @@map("gyms")
}

model MembershipPlan {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId    String   @map("gym_id") @db.Uuid
  planName String   @map("plan_name") @db.VarChar(100)
  gym      Gym      @relation(fields: [gymId], references: [id])
  members  Member[]

  @@map("membership_plans")
}

model Member {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId         String          @unique @default(dbgenerated("('GP' || lpad((nextval('member_id_sequence'::regclass))::text, 4, '0')")) @map("member_id") @db.VarChar(32)
  gymId            String          @map("gym_id") @db.Uuid
  membershipPlanId String          @map("membership_plan_id") @db.Uuid
  firstName        String          @map("first_name") @db.VarChar(100)
  lastName         String          @map("last_name") @db.VarChar(100)
  phone            String          @db.VarChar(30)
  qrCode           String          @map("qr_code") @db.VarChar(255)
  passwordHash     String?         @map("password_hash")
  gym              Gym             @relation(fields: [gymId], references: [id])
  membershipPlan   MembershipPlan  @relation(fields: [membershipPlanId], references: [id])

  @@index([memberId])
  @@map("members")
}
